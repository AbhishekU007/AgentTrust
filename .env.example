# AgentTrust environment variables (example)
# Copy this file to .env and fill in values for real Razorpay Test Mode.

# Database URL (optional). Defaults to sqlite:///./agenttrust.db when absent.
# Example for local SQLite (file path): sqlite:///./agenttrust.db
# Example for PostgreSQL: postgresql://user:pass@localhost:5432/agenttrust
AGENTTRUST_DB_URL=sqlite:///./agenttrust.db

# Razorpay Test Mode credentials
# When both are set, AgentTrust will use the real Razorpay Test API.
# Leave blank during local development to use the adapter's MOCKED mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: adjust logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
