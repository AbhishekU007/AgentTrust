@"
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/

# Logs / temporary files
*.log
*.tmp
scratch_*
pytest_output.txt
"@ | Set-Content .gitignore